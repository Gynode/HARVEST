# HARVEST pins the canonical npm registry for this repository.
#
# Without this, a machine whose global ~/.npmrc points at a mirror (this one uses
# registry.npmmirror.com) has every local `npm install` rewrite package-lock.json's
# `resolved` URLs to that mirror — which would put a third-party registry into the
# lockfile that the deploy workflow's `npm ci` reads. Pinning it here makes the
# lockfile canonical regardless of a contributor's global npm config.
#
# Deleting this file restores the previous behaviour.
registry=https://registry.npmjs.org/
